{
  "name": "Proactive AI — Collect every 15m",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 15 }]
        }
      },
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.APP_URL}}/api/webhooks/n8n",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{ \"workflow\": \"collect\" }"
      },
      "name": "Trigger collect pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 0]
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [[{ "node": "Trigger collect pipeline", "type": "main", "index": 0 }]]
    }
  },
  "meta": {
    "description": "Calls the Work Assistant collect+analyze pipeline every 15 minutes"
  }
}
