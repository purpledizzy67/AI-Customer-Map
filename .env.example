# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Encryption key for OAuth tokens (32+ char secret)
ENCRYPTION_KEY=change-me-to-a-long-random-secret-key

# OpenAI (Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Supabase / PostgreSQL
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Demo mode — uses mock data when true or when OAuth keys are missing
DEMO_MODE=true

# Google OAuth (Gmail + Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/auth/callback/slack
SLACK_SIGNING_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback/github

# Notion OAuth
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/api/auth/callback/notion

# n8n automation webhooks (optional)
N8N_WEBHOOK_BASE_URL=
N8N_COLLECT_WEBHOOK=
N8N_MORNING_WEBHOOK=
N8N_EVENING_WEBHOOK=

# Worker
COLLECT_INTERVAL_MINUTES=15
CONFIDENCE_THRESHOLD=0.8
