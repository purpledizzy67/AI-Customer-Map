# Optional: Apollo API key for lead/company enrichment (organization data)
APOLLO_API_KEY=

# Optional: Apify API key for robust Discord/Slack scraping (recommended for production)
APIFY_API_KEY=

# Optional: OpenAI API key for LLM-powered intent analysis (falls back to keyword scoring)
OPENAI_API_KEY=

# SQLite database path (default: ./data/intentmap.db)
DATABASE_PATH=./data/intentmap.db

# Default search keywords for discovery (comma-separated)
DEFAULT_KEYWORDS=saas,startup,marketing,seo,product,b2b,founder
